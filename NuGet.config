<?xml version="1.0" encoding="utf-8"?>
<!-- Fixa o nuget.org como única fonte de pacotes, ignorando feeds privados
     configurados na máquina (ex.: Grial/Xceed em nuget.uxdivers.com, que exige
     autenticação e retorna 401). Todos os pacotes deste projeto são públicos. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
